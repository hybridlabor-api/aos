{
  "groups": [
    {
      "group": "blender",
      "candidates": [
        {
          "name": "bdb_blender_official_mcp",
          "requires": {
            "app": "blender",
            "minVersion": "5.1"
          },
          "entry": {
            "command": "uvx",
            "args": [
              "--from",
              "git+https://projects.blender.org/lab/blender_mcp.git@ff54e4d8f6b09502f2f466189cca0e52b4a91643#subdirectory=mcp",
              "blender-mcp"
            ]
          }
        },
        {
          "name": "bdb_blender_mcp"
        }
      ]
    },
    {
      "group": "resolume",
      "candidates": [
        {
          "name": "bdb_resolume_official_mcp",
          "requires": {
            "app": "resolume"
          },
          "entry": {
            "command": "__RESOLUME_MCP__",
            "args": []
          }
        },
        {
          "name": "bdb_resolume_mcp"
        }
      ]
    },
    {
      "group": "after_effects",
      "candidates": [
        {
          "name": "bdb_after_effects_mcp_legacy",
