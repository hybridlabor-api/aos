{
  "version": 1,
  "description": "Declarative node registry for /fabric-graph. The dispatcher reads this instead of hardcoding BUILD_NODES and NODE_ENUM. Adding a build domain = adding an entry here, not editing the dispatcher. executor (harness/model class) and scope (read-only | worktree-write | none) are optional and enforced by the dispatcher (graph.md, Workers and scopes). No model is pinned here: a node's model comes only from pipeline.json (docs/agent-models.md).",
  "common": ["read-the-damn-docs", "agenttrail", "archify", "plan-canvas", "stay-within-limits", "quick-recap", "verification-before-completion"],
  "chain": {
    "hops": {
      "master_session": "human-facing supervisor, not a node; relays the human's GO, never grants one (docs/orchestrator-chain.md)",
      "project_orchestrator": "the dispatcher (.claude/workflows/fabric-dispatch.mjs); decides every edge",
      "package_orchestrator": "a build node or a worker slice (aos-acp / aos-a2a spawn)"
    },
    "node_hop": {
      "architect": "project_orchestrator",
      "techlead": "project_orchestrator",
      "ui_ux": "package_orchestrator",
      "engineering": "package_orchestrator",
      "media_eventtech": "package_orchestrator",
      "reviewer": "project_orchestrator",
      "shipping": "project_orchestrator"
    },
    "mcp_gateway": {
      "entry": "aos",
      "endpoint": "127.0.0.1:7790",
      "doc": "docs/mcp-gateway.md",
      "code": "lib/gateway/, lib/v5/pkg-gateway.js"
    },
    "a2a": {
      "cli": "bin/aos-a2a.mjs",
      "doc": "docs/a2a.md",
      "max_depth_env": "AOS_A2A_MAX_DEPTH",
      "never_go": true
    },
    "fleet_mod": {
      "path": "plugins/bdb-aos-fleet",
      "read_by_dispatcher": false
    }
  },
  "nodes": {
    "architect": {
      "label": "Architect",
      "agentType": "architect",
      "personaFile": ".claude/agents/architect.md",
      "role": "plan",
      "artifactKey": "plan",
      "writes": null,
      "optional": false,
      "executor": "planner",
      "scope": "read-only",
      "skills": [
        "read-the-damn-docs",
        "bdbrainstorm",
        "planning-with-files",
        "concise-planning",
        "archify",
        "plan-arbiter"
      ],
      "instructions": null
    },
    "techlead": {
      "label": "TechLead",
