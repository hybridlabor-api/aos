+def _llm_config():
+    """Extraction LLM from MEMB_LLM_* (set by aos-mcp-env from the user's OpenWiki/secrets choice); gemini by default."""
+    provider = os.environ.get("MEMB_LLM_PROVIDER", "gemini")
+    cfg = {}
+    model = os.environ.get("MEMB_LLM_MODEL") or ("gemini-2.5-flash" if provider == "gemini" else None)
+    if model:
+        cfg["model"] = model
+    if os.environ.get("MEMB_LLM_API_KEY"):
+        cfg["api_key"] = os.environ["MEMB_LLM_API_KEY"]
+    base = os.environ.get("MEMB_LLM_BASE_URL")
+    if base:
+        cfg[{"anthropic": "anthropic_base_url"}.get(provider, "openai_base_url")] = base
+    return {"provider": provider, "config": cfg}
 
