{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/hybridlabor-api/aos/evolve/schema/probe.schema.json",
  "title": "AOS Evolve Benchmark Probe Definition",
  "description": "Deterministic test probe definition for validating skills in isolated sandbox runs.",
  "type": "object",
  "required": [
    "version",
    "id",
    "skill",
    "task",
    "checker",
    "seed",
    "repeats",
    "timeout_s",
    "max_tokens"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Schema format version, currently 1."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$",
      "description": "Unique benchmark probe ID."
    },
    "skill": {
      "type": "string",
      "minLength": 1,
      "description": "Target skill directory name under skills/."
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "description": "Description of the task to execute with the skill."
    },
    "harness": {
      "type": "string",
      "description": "Target execution harness (claude, opencode-go, agy, codex)."
    },
    "role": {
      "type": "string",
      "description": "Target role (e.g. builder, specialist)."
    },
    "seed": {
      "type": "integer",
      "description": "Evaluation seed."
    },
    "repeats": {
      "type": "integer",
      "minimum": 1,
      "description": "Number of evaluation repetitions."
    },
    "timeout_s": {
      "type": "integer",
      "minimum": 1,
      "description": "Timeout in seconds."
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1,
      "description": "Maximum token budget for this probe."
    },
    "checker": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+\\.(mjs|js|sh)$",
      "description": "Basename of test checker executable (e.g. check.mjs)."
    },
    "expected": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9._-]+\\.(json|txt|mjs|js)$",
      "description": "Basename of expected output golden file (e.g. expected.json)."
    },
    "origin": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "failure",
            "handwritten"
          ]
        },
        "failure_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Categorization tags (e.g. target, heldout)."
    }
  },
  "additionalProperties": false
}
